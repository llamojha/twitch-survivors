  },
  "dependencies": {
    "@tauri-apps/plugin-shell": "2.3.5",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.0",
    "playwright": "1.58.2",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
