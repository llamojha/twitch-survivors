{
  "name": "twitch-survivors",
  "version": "0.1.0",
  "description": "Twitch Survivors — audience-driven survivor game (migration in progress)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
