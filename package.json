{
  "name": "twitch-survivors",
  "version": "0.1.0",
  "private": true,
  "description": "Audience-driven browser survivor game for Twitch",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "audit:assets": "node tools/audit-release-assets.js",
    "build": "node tools/build.js --sin-seo",
    "build:vercel": "npm run build && node tools/package-vercel.js",
    "build:test": "node tools/build.js --expose --sin-seo",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
